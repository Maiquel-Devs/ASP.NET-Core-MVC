@{
    ViewData["Title"] = "Meu Progresso";
}

<div class="container mt-4">
    <div class="row align-items-center mb-5">
        <div class="col-md-6">
            <h2 class="fw-bold">📊 Estatísticas de Estudo</h2>
            <p class="text-muted">Veja o seu desempenho com as 1.996 palavras.</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-controller="Quiz" asp-action="Index" class="btn btn-primary btn-lg px-4">Voltar ao Quiz</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 p-3 text-center">
                <h5 class="mb-3">Aproveitamento Geral</h5>
                <canvas id="chartProgresso" style="max-height: 300px;"></canvas>
            </div>
        </div>

        <div class="col-md-8">
            <div class="row">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-success text-white fw-bold">✅ Acertos (@ViewBag.TotalAcertos)</div>
                        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                            <ul class="list-group list-group-flush">
                                @foreach (var item in ViewBag.ListaAcertos)
                                {
                                    <li class="list-group-item">
                                        <span class="fw-bold">@item.Palavra.Ingles</span> <br>
                                        <small class="text-muted">@item.Palavra.Portugues</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-danger text-white fw-bold">❌ Erros (@ViewBag.TotalErros)</div>
                        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                            <ul class="list-group list-group-flush">
                                @foreach (var item in ViewBag.ListaErros)
                                {
                                    <li class="list-group-item">
                                        <span class="fw-bold">@item.Palavra.Ingles</span> <br>
                                        <small class="text-muted">@item.Palavra.Portugues</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('chartProgresso');
    new Chart(ctx, {
        type: 'doughnut', // Gráfico em formato de rosca (mais moderno que pizza)
        data: {
            labels: ['Acertos', 'Erros'],
            datasets: [{
                data: [@ViewBag.TotalAcertos, @ViewBag.TotalErros],
                backgroundColor: ['#198754', '#dc3545'],
                borderWidth: 0
            }]
        },
        options: {
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>