@{
    ViewData["Title"] = "Dashboard Financeiro";
}

<div class="container mt-4 text-center">
    <h2 class="mb-4 fw-bold">Resumo da Saúde Financeira</h2>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm p-3">
                <canvas id="graficoFinanceiro" style="max-height: 350px;"></canvas>
            </div>
        </div>
    </div>

    <div class="mt-5 p-4 bg-white border rounded shadow-sm">
        <h4 class="text-secondary text-uppercase" style="letter-spacing: 1px;">Comprometimento da Renda</h4>
        
        @* O valor vem da Controller e o estilo é fixo em vermelho como solicitado *@
        <h1 class="display-1" style="color: red; font-weight: 900;">
            @ViewBag.Porcentagem.ToString("F1")%
        </h1>
        
        <div class="d-flex justify-content-center gap-4 mt-3">
            <span class="badge bg-success fs-6">Renda: R$ @ViewBag.TotalRenda.ToString("N2")</span>
            <span class="badge bg-danger fs-6">Despesas: R$ @ViewBag.TotalDespesa.ToString("N2")</span>
        </div>
    </div>

    <div class="mt-4 mb-5">
        <a asp-controller="Home" asp-action="Lancamentos" class="btn btn-primary btn-lg px-5 shadow">
            <i class="bi bi-plus-circle"></i> Novo Lançamento
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('graficoFinanceiro').getContext('2d');

            // Pegando os dados que a Controller enviará via ViewBag
            // Usamos Replace para garantir que o JavaScript entenda o decimal com ponto
            const renda = @ViewBag.TotalRenda.ToString().Replace(",", ".");
            const despesa = @ViewBag.TotalDespesa.ToString().Replace(",", ".");

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Renda Total', 'Despesas Totais'],
                    datasets: [{
                        label: 'Valores em R$',
                        data: [renda, despesa],
                        backgroundColor: [
                            'rgba(25, 135, 84, 0.8)', // Verde para Renda
                            'rgba(220, 53, 69, 0.8)'  // Vermelho para Despesa
                        ],
                        borderColor: [
                            '#198754',
                            '#dc3545'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'R$ ' + value.toLocaleString('pt-BR');
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}