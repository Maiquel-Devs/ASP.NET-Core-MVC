<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Daily English</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar { background: linear-gradient(135deg, #0d6efd 0%, #0042a5 100%) !important; }
        .navbar-brand { font-size: 1.5rem; letter-spacing: 1px; }
        .nav-link { font-weight: 500; transition: 0.3s; }
        .nav-link:hover { opacity: 0.8; transform: translateY(-1px); }
        footer { background: white; border-top: 1px solid #dee2e6; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Quiz" asp-action="Index">
                    <i class="bi bi-translate me-2"></i>DAILY VOCABULARY
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-white px-3" asp-controller="Quiz" asp-action="Index">
                                <i class="bi bi-play-circle me-1"></i> Jogar Quiz
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-bar-chart-line me-1"></i> Estatísticas
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted py-4 mt-auto">
        <div class="container text-center">
            <small>&copy; 2026 - <strong>Daily English Vocabulary</strong> - Pratique todos os dias</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>