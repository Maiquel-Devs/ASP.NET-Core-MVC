@model IEnumerable<Asp.Net_Projeto09_ProjetoFinTrack.Models.Transacao>

@{
    ViewData["Title"] = "Gerenciar Lançamentos";
}

<div class="container mt-4">
    <div class="row justify-content-center mb-5">
        <div class="col-md-5">
            <div class="card border-success shadow-sm">
                <div class="card-header bg-success text-white">Adicionar Renda</div>
                <div class="card-body">
                    <form asp-action="SalvarRenda" method="post">
                        <input type="text" name="Nome" class="form-control mb-2" placeholder="Nome" required />
                        <input type="text" name="Categoria" class="form-control mb-2" placeholder="Categoria" required />
                        <input type="number" step="0.01" name="Valor" class="form-control mb-2" placeholder="Valor" required />
                        <button type="submit" class="btn btn-success w-100">Adicionar</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">Adicionar Despesa</div>
                <div class="card-body">
                    <form asp-action="SalvarDespesa" method="post">
                        <input type="text" name="Nome" class="form-control mb-2" placeholder="Nome" required />
                        <input type="text" name="Categoria" class="form-control mb-2" placeholder="Categoria" required />
                        <input type="number" step="0.01" name="Valor" class="form-control mb-2" placeholder="Valor" required />
                        <button type="submit" class="btn btn-danger w-100">Adicionar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Histórico de Movimentações (Do maior para o menor)</h5>
            <a asp-action="Index" class="btn btn-sm btn-info text-white">Ver Gráfico Atualizado</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th>Categoria</th>
                        <th>Valor</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge @(item.Tipo == "Renda" ? "bg-success" : "bg-danger")">
                                    @item.Tipo
                                </span>
                            </td>
                            <td>@item.Nome</td>
                            <td>@item.Categoria</td>
                            <td class="fw-bold">R$ @item.Valor.ToString("N2")</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-@item.Id">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                                <a asp-action="Excluir" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Tem certeza que deseja excluir?')">
                                    <i class="bi bi-trash"></i> Excluir
                                </a>
                            </td>
                        </tr>

                        <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <form asp-action="Editar" method="post">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Editar Lançamento</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <div class="mb-3">
                                                <label class="form-label">Descrição</label>
                                                <input type="text" name="Nome" class="form-control" value="@item.Nome" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Categoria</label>
                                                <input type="text" name="Categoria" class="form-control" value="@item.Categoria" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Valor</label>
                                                <input type="number" step="0.01" name="Valor" class="form-control" value="@item.Valor.ToString().Replace(",", ".")" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>