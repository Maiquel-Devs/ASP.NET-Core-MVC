@model Asp.Net_Projeto07_ProjetoAPI.Models.Usuario

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h1 class="card-title text-center mb-4">Login</h1>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @ViewBag.Erro
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" asp-action="ValidarConta">
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label fw-semibold">Usuário</label>
                            <input asp-for="Nome" class="form-control form-control-lg" placeholder="Digite seu usuário" required />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Senha" class="form-label fw-semibold">Senha</label>
                            <input asp-for="Senha" type="password" class="form-control form-control-lg" placeholder="Digite sua senha" required />
                            <span asp-validation-for="Senha" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg w-100 fw-semibold">Entrar</button>
                    </form>

                    <p class="text-center mt-4">
                        Não tem uma conta? 
                        <a asp-action="CriarConta" asp-controller="Account" class="text-decoration-none fw-semibold">Crie uma agora</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
